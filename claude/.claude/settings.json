{
  "apiKeyHelper": "fish -c 'agent-secret CLIPROXYAPI_API_KEY'",
  "env": {
    "ANTHROPIC_BASE_URL": "https://cliproxyapi.ians.cloud"
  },
  "model": "opus",
  "enabledPlugins": {
    "claude-code-wakatime@wakatime": true
  },
  "extraKnownMarketplaces": {
    "wakatime": {
      "source": {
        "source": "git",
        "url": "https://github.com/wakatime/claude-code-wakatime.git"
      }
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto"
}
