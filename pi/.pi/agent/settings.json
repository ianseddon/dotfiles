{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "defaultProvider": "cpa",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "cpa/claude-opus-5-5",
    "cpa/kimi-k3.1-pro",
    "cpa/opencode-go/kimi-k3.1-pro",
    "cpa/gpt-6.1-sol"
  ],
  "packages": [
    "npm:pi-wakatime",
    "npm:pi-web-access",
    "npm:@hank-warren/pi-cliproxyapi-provider",
    "npm:@nicknisi/pi-session-name"
  ],
  "defaultTools": [
    "+codemode"
  ],
  "warnings": {
    "anthropicExtraUsage": false
  },
  "hideThinkingBlock": true,
  "defaultProjectTrust": "always",
  "enableInstallTelemetry": false,
  "collapseChangelog": true,
  "quietStartup": "header",
  "selfUpdateCommand": [
    "sh",
    "-c",
    "echo \"pi comes from Nix: bump inputs.pi.url in ~/dotfiles/nix/flake.nix to v{version}\" >&2; exit 1"
  ]
}
