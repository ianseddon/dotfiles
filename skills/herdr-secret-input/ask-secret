#!/usr/bin/env bash
# ask-secret: ask Ian for a secret in a Herdr popup and print the path of a
# private file holding it. The value itself is never printed.
#
#   ask-secret <label> [--reason <text>] [--timeout <seconds>]
#
# The file is 0600 in a 0700 directory under $XDG_RUNTIME_DIR, holds the value
# trimmed of surrounding whitespace with no trailing newline, and is the
# caller's to delete. Its byte length always goes to stderr, so a value that is
# empty or the wrong size shows up without reading it.
#
# Exit status: 0 stored, 1 cancelled, 2 usage or setup error, 124 timed out.
set -euo pipefail

herdr=${HERDR_BIN_PATH:-herdr}
plugin=secret-input
label="" reason="" timeout=600

die() { echo "ask-secret: $1" >&2; exit "${2:-2}"; }

while [ $# -gt 0 ]; do
  case $1 in
    --reason) reason=${2-}; shift 2 ;;
    --timeout) timeout=${2-}; shift 2 ;;
    -h | --help) sed -n '2,12p' "$0"; exit 0 ;;
    -*) die "unknown option: $1" ;;
    *) [ -z "$label" ] || die "unexpected argument: $1"; label=$1; shift ;;
  esac
done
[ -n "$label" ] || die "usage: ask-secret <label> [--reason <text>] [--timeout <seconds>]"
[[ $timeout =~ ^[1-9][0-9]*$ ]] || die "--timeout takes a whole number of seconds"
[ "${HERDR_ENV:-}" = 1 ] || die "not running inside a Herdr pane"
command -v jq >/dev/null || die "jq is not on PATH"
# The popup is the herdr plugin beside this script. The two talk through files,
# so herdr must run this copy: link it on first use, and re-link it when herdr
# has another copy (an older install, or one that moved).
plugin_root=$(cd -P "$(dirname "$0")/herdr-plugin" && pwd) || die "herdr-plugin/ is missing beside $0"
plugin_info() {
  "$herdr" plugin list --plugin "$plugin" --json |
    jq -c --arg id "$plugin" '.result.plugins[] | select(.plugin_id == $id)'
}
info=$(plugin_info) || die "herdr plugin list failed"
if [ "$(jq -r '.plugin_root // empty' <<<"$info")" != "$plugin_root" ]; then
  [ -z "$info" ] || "$herdr" plugin unlink "$plugin" >/dev/null || die "could not unlink the stale $plugin plugin"
  "$herdr" plugin link "$plugin_root" >/dev/null || die "could not link the popup: herdr plugin link $plugin_root"
  info=$(plugin_info) || die "herdr plugin list failed"
fi
jq -e .enabled <<<"$info" >/dev/null || die "the $plugin herdr plugin is disabled: herdr plugin enable $plugin"
width=$(jq -er '.panes[] | select(.id == "prompt") | .width' <<<"$info") || die "the $plugin plugin has no prompt pane"

dir=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/herdr-secrets
mkdir -p "$dir" && chmod 700 "$dir"
out=$(mktemp -u "$dir/XXXXXXXXXX")

# "pi · dotfiles": the agent in this pane and its workspace
agent=$("$herdr" pane get "${HERDR_PANE_ID:-}" 2>/dev/null | jq -r '.result.pane.agent // empty') || agent=""
space=$("$herdr" workspace get "${HERDR_WORKSPACE_ID:-}" 2>/dev/null | jq -r '.result.workspace.label // empty') || space=""
from=${agent}${agent:+${space:+ · }}${space}

# Fit the height to the reason, wrapped the way secret-prompt wraps it: inside
# the border and a two-column margin, at most three lines.
reason_lines=0
[ -z "$reason" ] || reason_lines=$(printf '%s\n' "$reason" | fold -s -w $((width - 6)) | head -n 3 | wc -l)
height=$((13 + reason_lines))

# Popups attach to whichever pane Ian has active, and herdr returns no handle
# for them: the popup reports through files beside $out (see secret-prompt).
# Only one popup can be open at a time, so wait out another one (Ian's own, or
# an earlier secret popup still closing) within the timeout.
deadline=$((SECONDS + timeout))
until err=$("$herdr" plugin pane open --plugin "$plugin" --entrypoint prompt --focus --height "$height" \
  --env "SECRET_OUT=$out" --env "SECRET_LABEL=$label" --env "SECRET_REASON=$reason" \
  --env "SECRET_FROM=$from" --env "SECRET_TIMEOUT=$timeout" --env "SECRET_CALLER=$$" 2>&1 >/dev/null); do
  [[ $err == *'"ui_busy"'* ]] || die "herdr could not open the popup: $err"
  [ "$SECONDS" -lt "$deadline" ] || die "another popup stayed open for ${timeout}s" 124
  sleep 0.5
done

cleanup() { rm -f "$out.pid" "$out.part" "$out.cancel" "$out.timeout"; }
popup_alive() { local pid; pid=$(cat "$out.pid" 2>/dev/null) && kill -0 "$pid" 2>/dev/null; }
abort() {
  local pid tries=10
  if pid=$(cat "$out.pid" 2>/dev/null); then
    kill -TERM "$pid" 2>/dev/null || true
    while popup_alive && [ $((tries--)) -gt 0 ]; do sleep 0.2; done
  fi
  cleanup
  rm -f "$out"
  exit "$1"
}
trap 'abort 130' INT TERM HUP

result() {
  if [ -e "$out" ]; then
    cleanup
    echo "ask-secret: stored $(wc -c <"$out" | tr -d ' ') bytes" >&2
    printf '%s\n' "$out"
    exit 0
  fi
  [ -e "$out.cancel" ] && { cleanup; die "cancelled by Ian" 1; }
  [ -e "$out.timeout" ] && { cleanup; die "no answer within ${timeout}s" 124; }
  return 0
}

# The popup enforces the timeout itself; this only catches one that never ran.
start_by=$((SECONDS + 10))
while :; do
  result
  if [ -e "$out.pid" ]; then
    popup_alive || { result; cleanup; die "popup closed without an answer" 1; }
  elif [ "$SECONDS" -ge "$start_by" ]; then
    cleanup
    die "the popup never started"
  fi
  sleep 0.2
done
