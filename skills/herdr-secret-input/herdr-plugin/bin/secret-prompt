#!/usr/bin/env bash
# Popup entrypoint: read one secret with masked input and hand it to ask-secret.
#
# Environment, set by ask-secret through `herdr plugin pane open --env`:
#   SECRET_OUT     file to create; the value is written to SECRET_OUT.part and
#                  renamed into place, so the caller never sees a partial write
#   SECRET_LABEL   what is being asked for, e.g. "GitHub token"
#   SECRET_REASON  optional: why the agent needs it
#   SECRET_FROM    optional: who is asking, e.g. "pi · dotfiles"
#   SECRET_TIMEOUT optional: seconds before giving up (default 600)
#   SECRET_CALLER  optional: pid waiting for the answer; once it is gone the
#                  popup closes without writing anything
#
# Herdr returns no handle for a popup, so the popup reports on itself: its pid
# in SECRET_OUT.pid while it runs (SIGTERM cancels it), then SECRET_OUT on
# submit, SECRET_OUT.cancel on esc, ctrl-c or ctrl-d, or SECRET_OUT.timeout.
# ctrl-u clears. The value is trimmed of leading and trailing whitespace and
# written without a trailing newline; enter does nothing until it is non-empty.
set -uo pipefail
umask 077

out=${SECRET_OUT:?SECRET_OUT is not set}
label=${SECRET_LABEL:-Secret}
reason=${SECRET_REASON:-}
from=${SECRET_FROM:-}
caller=${SECRET_CALLER:-}
deadline=$((SECONDS + ${SECRET_TIMEOUT:-600}))
printf '%s\n' "$$" >"$out.pid"

# Kanagawa (Wave), matching herdr's theme
violet=$'\e[38;2;149;127;184m' # oniViolet
blue=$'\e[38;2;126;156;216m'   # crystalBlue
white=$'\e[38;2;220;215;186m'  # fujiWhite
gray=$'\e[38;2;114;113;105m'   # fujiGray
green=$'\e[38;2;152;187;108m'  # springGreen
red=$'\e[38;2;232;36;36m'      # samuraiRed
bold=$'\e[1m' reset=$'\e[0m'

secret=""
input_row=0 box_w=0

repeat() { local s; printf -v s '%*s' "$2" ''; printf '%s' "${s// /$1}"; }

draw() {
  local cols=${COLUMNS:-72} row=1 line
  box_w=$((cols - 4))
  printf '\e[?25l\e[2J\e[H'

  row=$((row + 1))
  printf '\e[%d;3H%s%s◆ Secret requested%s' "$row" "$violet" "$bold" "$reset"
  if [ -n "$from" ] && [ $((${#from} + 22)) -lt "$cols" ]; then
    printf '\e[%d;%dH%s%s%s' "$row" $((cols - ${#from} - 1)) "$gray" "$from" "$reset"
  fi

  row=$((row + 2))
  printf '\e[%d;3H%s%s%s%s' "$row" "$white" "$bold" "${label:0:box_w}" "$reset"
  if [ -n "$reason" ]; then
    while IFS= read -r line; do
      row=$((row + 1))
      printf '\e[%d;3H%s%s%s' "$row" "$gray" "$line" "$reset"
    done < <(printf '%s\n' "$reason" | fold -s -w "$box_w" | head -n 3)
  fi

  row=$((row + 2))
  printf '\e[%d;3H%s╭%s╮' "$row" "$blue" "$(repeat ─ $((box_w - 2)))"
  input_row=$((row + 1))
  printf '\e[%d;3H│\e[%d;%dH│' "$input_row" "$input_row" $((box_w + 2))
  printf '\e[%d;3H╰%s╯%s' $((row + 2)) "$(repeat ─ $((box_w - 2)))" "$reset"

  printf '\e[%d;3H%senter%s submit  %s·%s  %sesc%s cancel  %s·%s  %sctrl-u%s clear%s' $((row + 4)) \
    "$white" "$gray" "$gray" "$gray" "$white" "$gray" "$gray" "$gray" "$white" "$gray" "$reset"
  draw_input
}

# What gets stored: the input without leading or trailing whitespace
trimmed() {
  local s=${secret#"${secret%%[![:space:]]*}"}
  printf '%s' "${s%"${s##*[![:space:]]}"}"
}

# Byte length of the trimmed input, the same number ask-secret reports
bytes() { local LC_ALL=C s; s=$(trimmed); printf '%d' "${#s}"; }

# Redraw only the field: a bullet per character typed, capped to the box, and
# the stored byte count so a paste can be checked at a glance.
draw_input() {
  local n=${#secret} count="" room shown
  [ "$n" -gt 0 ] && count="$(bytes) bytes"
  room=$((box_w - 6 - ${#count}))
  shown=$((n < room ? n : room))
  printf '\e[%d;5H%s%s' "$input_row" "$violet" "›"
  printf '\e[%d;7H%s%s%s' "$input_row" "$white" "$(repeat • "$shown")" "$reset"
  printf '%*s' $((room - shown)) ''
  printf '%s%s%s ' "$gray" "$count" "$reset"
  printf '\e[%d;%dH\e[?25h' "$input_row" $((7 + shown))
}

caller_gone() { [ -n "$caller" ] && ! kill -0 "$caller" 2>/dev/null; }

finish() {
  local state=$1
  caller_gone && state=orphaned
  printf '\e[%d;5H%*s' "$input_row" $((box_w - 3)) ''
  case $state in
    ok)
      trimmed >"$out.part" && mv -f "$out.part" "$out"
      printf '\e[%d;5H%s✓ handed to the agent%s\e[?25l' "$input_row" "$green" "$reset" ;;
    cancel)
      : >"$out.cancel"
      printf '\e[%d;5H%s✗ cancelled%s\e[?25l' "$input_row" "$red" "$reset" ;;
    timeout)
      : >"$out.timeout"
      printf '\e[%d;5H%s✗ timed out%s\e[?25l' "$input_row" "$red" "$reset" ;;
    orphaned)
      rm -f "$out.pid"
      printf '\e[%d;5H%s✗ the agent stopped waiting%s\e[?25l' "$input_row" "$red" "$reset"
      sleep 1 ;;
  esac
  secret=""
  sleep 0.4
  exit 0
}

trap 'finish cancel' INT TERM HUP
trap 'COLUMNS=$(tput cols); draw' WINCH
COLUMNS=$(tput cols 2>/dev/null || echo 72)
draw

while :; do
  remaining=$((deadline - SECONDS))
  [ "$remaining" -gt 0 ] || finish timeout
  # Wake every second to check the caller is still waiting
  IFS= read -rsn1 -t "$((remaining < 1 ? remaining : 1))" c
  status=$?
  # >128: the timeout, or a trap (resize) interrupting the read
  if [ "$status" -gt 128 ]; then
    caller_gone && finish orphaned
    continue
  fi
  [ "$status" -eq 0 ] || finish cancel
  case $c in
    "") [ -n "$(trimmed)" ] && finish ok ;;
    $'\e')
      # A lone esc cancels; an escape sequence (arrow keys, focus events) is drained.
      if IFS= read -rsn1 -t 0.05 _; then
        while IFS= read -rsn1 -t 0.01 _; do :; done
      else
        finish cancel
      fi
      ;;
    $'\x04') finish cancel ;;
    $'\x7f' | $'\b') secret=${secret%?} ;;
    $'\x15') secret="" ;;
    [[:cntrl:]]) ;;
    *) secret+=$c ;;
  esac
  # A paste arrives as a burst; redraw once it is drained, not per character.
  read -t 0 || draw_input
done
