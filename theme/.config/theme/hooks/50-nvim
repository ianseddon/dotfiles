#!/bin/sh
# Running nvim instances re-run the theme's nvim.lua, so they switch colour scheme
# live. nvim listens on $XDG_RUNTIME_DIR/nvim.<pid>.0 by default. An nvim that
# doesn't answer within 2 seconds (busy, or a stale socket) is reported, not fatal.
set -eu
file=${THEME_CURRENT:-}/nvim.lua
[ -f "$file" ] || exit 0

for socket in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/nvim.*; do
  [ -S "$socket" ] || continue
  if ! timeout 2 nvim --server "$socket" --remote-expr "luaeval('dofile(_A)', '$file')" >/dev/null 2>&1; then
    echo "theme: the nvim at $socket did not reload" >&2
  fi
done
