# Generated by `theme set` from templates/vicinae.toml.tpl; installed by the
# 35-vicinae hook as ~/.local/share/vicinae/themes/dotfiles.toml.
[meta]
name = "Dotfiles"
description = "The current theme from the dotfiles (theme set)"
variant = "{{ mode }}"
inherits = "vicinae-{{ mode }}"

[colors.core]
accent = "{{ accent }}"
accent_foreground = "{{ background }}"
background = "{{ background }}"
foreground = "{{ foreground }}"
secondary_background = "{{ dark_background }}"
border = "{{ lighter_background }}"

[colors.main_window]
border = "{{ lighter_background }}"

[colors.settings_window]
border = "{{ lighter_background }}"

[colors.accents]
blue = "{{ blue }}"
green = "{{ green }}"
magenta = "{{ magenta }}"
orange = "{{ orange }}"
red = "{{ red }}"
yellow = "{{ yellow }}"
cyan = "{{ cyan }}"
purple = "{{ magenta }}"

[colors.text]
default = "{{ foreground }}"
muted = "{{ dark_foreground }}"
danger = "{{ red }}"
success = "{{ green }}"
placeholder = "{{ dark_foreground }}"
selection = { background = "{{ selection }}", foreground = "{{ bright_foreground }}" }

[colors.text.links]
default = "{{ blue }}"
visited = "{{ magenta }}"

[colors.input]
border = "{{ lighter_background }}"
border_focus = "{{ accent }}"
border_error = "{{ red }}"

[colors.list.item.selection]
background = "{{ lighter_background }}"
foreground = "{{ bright_foreground }}"
secondary_background = "{{ lighter_background }}"
secondary_foreground = "{{ foreground }}"

[colors.grid.item]
background = "{{ dark_background }}"
hover = { outline = "{{ dark_foreground }}" }
selection = { outline = "{{ accent }}" }
