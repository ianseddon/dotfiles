#!/usr/bin/env python3
"""Switch the desktop colour scheme.

A theme is a folder holding a `colors.toml` palette (Omarchy's schema). `theme set`
renders every template in the templates folder with that palette, switches
~/.local/state/theme/current to the result in one step, then runs the reload hooks.
Design: docs/desktop-shell/SPEC-theme.md in the dotfiles repo.
"""

import argparse
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib
from dataclasses import dataclass
from pathlib import Path
from xml.sax.saxutils import escape

REQUIRED_COLOURS = (
    "accent",
    "selection",
    "muted",
    "background",
    "dark_background",
    "darker_background",
    "lighter_background",
    "foreground",
    "dark_foreground",
    "light_foreground",
    "bright_foreground",
    "red",
    "yellow",
    "orange",
    "green",
    "cyan",
    "blue",
    "magenta",
    "brown",
    "bright_red",
    "bright_yellow",
    "bright_green",
    "bright_cyan",
    "bright_blue",
    "bright_magenta",
)
MODES = ("dark", "light")
# Files every render writes itself, so a theme folder may not ship them.
GENERATED = ("name", "palette.json")
PALETTE_FILE = "colors.toml"
TEMPLATE_SUFFIX = ".tpl"
# A reload that takes longer than this is treated as hung.
HOOK_TIMEOUT_SECONDS = 10
# `theme font <kind>` sets the preferred family for this fontconfig alias.
FONT_ALIASES = {"mono": "monospace", "sans": "sans-serif"}
# Follows every monospace choice, so fonts without a Nerd Font build still show icons.
ICON_FALLBACK = "Symbols Nerd Font"

THEME_NAME = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*")
HEX_COLOUR = re.compile(r"#[0-9a-fA-F]{6}")
PLACEHOLDER = re.compile(r"\{\{\s*([A-Za-z0-9_]+)\s*\}\}")


class ThemeError(Exception):
    """A problem with a theme or template that stops a render."""


class RenderError(ThemeError):
    """A template refers to something the palette does not have."""


@dataclass(frozen=True)
class Palette:
    name: str
    values: dict[str, str]
    folder: Path

    def resolve(self, token: str) -> str | None:
        """The value for a placeholder: a key, or a colour key with _strip or _rgb."""
        if token in self.values:
            return self.values[token]
        key, _, form = token.rpartition("_")
        colour = self.values.get(key)
        if colour is None or not HEX_COLOUR.fullmatch(colour):
            return None
        if form == "strip":
            return colour[1:]
        if form == "rgb":
            return ",".join(str(int(colour[i : i + 2], 16)) for i in (1, 3, 5))
        return None


def load_palette(folder: Path) -> Palette:
    name = folder.name
    if not THEME_NAME.fullmatch(name):
        raise ThemeError(f"theme name '{name}' must be lowercase kebab-case")
    path = folder / PALETTE_FILE
    try:
        raw = tomllib.loads(path.read_text())
    except FileNotFoundError:
        raise ThemeError(f"{path}: not found") from None
    except tomllib.TOMLDecodeError as error:
        raise ThemeError(f"{path}: invalid TOML: {error}") from None

    values: dict[str, str] = {}
    for key, value in raw.items():
        if key in GENERATED:
            raise ThemeError(f"{path}: '{key}' is reserved")
        if not isinstance(value, str):
            raise ThemeError(f"{path}: '{key}' must be a string")
        values[key] = value

    # Omarchy's fallbacks for the two colours several of its themes leave out.
    if "orange" not in values and "yellow" in values:
        values["orange"] = values["yellow"]
    if "brown" not in values and HEX_COLOUR.fullmatch(values.get("orange", "")):
        values["brown"] = mix(values["orange"], "#000000", 0.5)

    for key in ("mode", *REQUIRED_COLOURS):
        if key not in values:
            raise ThemeError(f"{path}: missing key '{key}'")
    if values["mode"] not in MODES:
        raise ThemeError(f"{path}: 'mode' must be 'dark' or 'light', got '{values['mode']}'")
    for key in REQUIRED_COLOURS:
        if not HEX_COLOUR.fullmatch(values[key]):
            raise ThemeError(f"{path}: '{key}' must be #rrggbb, got '{values[key]}'")
    return Palette(name, values, folder)


def mix(start: str, end: str, amount: float) -> str:
    """Blend two #rrggbb colours, rounding halves up as Omarchy's mix_color does."""
    channels = (
        int(int(start[i : i + 2], 16) * (1 - amount) + int(end[i : i + 2], 16) * amount + 0.5)
        for i in (1, 3, 5)
    )
    return "#" + "".join(f"{channel:02x}" for channel in channels)


def render(template: str, palette: Palette, *, source: Path) -> str:
    """Replace every {{ key }} placeholder, or fail naming the first unknown key."""

    def substitute(match: re.Match[str]) -> str:
        token = match.group(1)
        value = palette.resolve(token)
        if value is None:
            line = template.count("\n", 0, match.start()) + 1
            raise RenderError(f"{source}:{line}: unknown palette key '{token}'")
        return value

    return PLACEHOLDER.sub(substitute, template)


def render_theme(palette: Palette, templates: Path, out: Path) -> None:
    """Write a theme's files into `out`: its own files first, then templates for the rest."""
    for file in sorted(palette.folder.iterdir()):
        if not file.is_file() or file.name == PALETTE_FILE:
            continue
        if file.name in GENERATED:
            raise ThemeError(f"{file}: {file.name} is generated and cannot be part of a theme")
        shutil.copyfile(file, out / file.name)

    if templates.is_dir():
        for template in sorted(templates.glob(f"*{TEMPLATE_SUFFIX}")):
            target = out / template.name.removesuffix(TEMPLATE_SUFFIX)
            if not target.exists():
                target.write_text(render(template.read_text(), palette, source=template))

    (out / "name").write_text(f"{palette.name}\n")
    (out / "palette.json").write_text(json.dumps({"name": palette.name, **palette.values}, indent=2) + "\n")


@dataclass(frozen=True)
class Paths:
    config: Path
    state: Path

    @classmethod
    def from_env(cls) -> Paths:
        home = Path.home()
        config_home = Path(os.environ.get("XDG_CONFIG_HOME") or home / ".config")
        state_home = Path(os.environ.get("XDG_STATE_HOME") or home / ".local" / "state")
        config = Path(os.environ.get("THEME_CONFIG_DIR") or config_home / "theme")
        return cls(config=config, state=state_home / "theme")

    @property
    def themes(self) -> Path:
        return self.config / "themes"

    @property
    def templates(self) -> Path:
        return self.config / "templates"

    @property
    def hooks(self) -> Path:
        return self.config / "hooks"

    @property
    def current(self) -> Path:
        return self.state / "current"

    @property
    def renders(self) -> Path:
        return self.state / "renders"

    @property
    def font_choices(self) -> Path:
        return self.state / "fonts.json"

    @property
    def fonts_conf(self) -> Path:
        return self.state / "fonts.conf"


def theme_names(paths: Paths) -> list[str]:
    if not paths.themes.is_dir():
        return []
    return sorted(d.name for d in paths.themes.iterdir() if (d / PALETTE_FILE).is_file())


def find_theme(paths: Paths, name: str) -> Path:
    folder = paths.themes / name
    if not (folder / PALETTE_FILE).is_file():
        raise ThemeError(f"no theme named '{name}' in {paths.themes}")
    return folder


def current_name(paths: Paths) -> str | None:
    try:
        return (paths.current / "name").read_text().strip()
    except FileNotFoundError:
        return None


def switch(paths: Paths, palette: Palette) -> None:
    """Render into a fresh folder, then point `current` at it in one rename.

    Readers see the old theme or the new one, never a mix. On a render error the
    new folder is removed and `current` is left alone.
    """
    paths.renders.mkdir(parents=True, exist_ok=True)
    with (paths.state / "lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        target = Path(tempfile.mkdtemp(prefix=f"{palette.name}.", dir=paths.renders))
        try:
            render_theme(palette, paths.templates, target)
        except BaseException:
            shutil.rmtree(target)
            raise
        target.chmod(0o755)  # mkdtemp makes it 0700; the greeter hook and others read it

        link = paths.state / f".current.{os.getpid()}"
        link.unlink(missing_ok=True)
        link.symlink_to(target.relative_to(paths.state))
        link.replace(paths.current)

        for old in paths.renders.iterdir():
            if old != target:
                shutil.rmtree(old)


def run_hooks(paths: Paths, name: str) -> list[str]:
    """Run each executable hook in name order. Returns a message per failed hook."""
    if not paths.hooks.is_dir():
        return []
    env = {**os.environ, "THEME_CURRENT": str(paths.current)}
    failures: list[str] = []
    for hook in sorted(paths.hooks.iterdir()):
        if not hook.is_file() or not os.access(hook, os.X_OK):
            continue
        try:
            code = subprocess.run([hook, name], env=env, timeout=HOOK_TIMEOUT_SECONDS, check=False).returncode
        except subprocess.TimeoutExpired:
            failures.append(f"hook {hook.name} timed out after {HOOK_TIMEOUT_SECONDS}s")
        except OSError as error:
            failures.append(f"hook {hook.name} could not start: {error}")
        else:
            if code != 0:
                failures.append(f"hook {hook.name} failed (exit {code})")
    return failures


def report_hooks(paths: Paths, name: str, done: str) -> int:
    failures = run_hooks(paths, name)
    for failure in failures:
        print(f"theme: {done}, but {failure}", file=sys.stderr)
    return 2 if failures else 0


def cmd_set(paths: Paths, name: str) -> int:
    try:
        switch(paths, load_palette(find_theme(paths, name)))
    except (ThemeError, OSError) as error:
        print(f"theme: {error}", file=sys.stderr)
        return 1
    return report_hooks(paths, name, f"switched to {name}")


def write_atomic(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}")
    temporary.write_text(text)
    temporary.replace(path)


def installed_families() -> list[str]:
    listing = subprocess.run(["fc-list", ":", "family"], capture_output=True, text=True, check=True).stdout
    # A line lists a font's family names, comma-separated (localised and style-specific ones).
    return sorted({name.strip() for line in listing.splitlines() for name in line.split(",") if name.strip()})


def resolved_family(alias: str) -> str:
    return subprocess.run(
        ["fc-match", "-f", "%{family[0]}", alias], capture_output=True, text=True, check=True
    ).stdout.strip()


def fonts_conf(choices: dict[str, str]) -> str:
    """A fontconfig file preferring the chosen families. Included before the tracked defaults."""
    aliases: list[str] = []
    for kind, alias in FONT_ALIASES.items():
        if kind not in choices:
            continue
        families = [choices[kind], ICON_FALLBACK] if kind == "mono" else [choices[kind]]
        prefer = "".join(f"\n      <family>{escape(family)}</family>" for family in families)
        aliases.append(
            f"  <alias>\n    <family>{alias}</family>\n    <prefer>{prefer}\n    </prefer>\n  </alias>\n"
        )
    return (
        '<?xml version="1.0"?>\n<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">\n'
        "<!-- Generated by `theme font`; included by ~/.config/fontconfig/fonts.conf. -->\n"
        f"<fontconfig>\n{''.join(aliases)}</fontconfig>\n"
    )


def cmd_font(paths: Paths, kind: str | None, family: str | None) -> int:
    if kind is None:
        for name, alias in FONT_ALIASES.items():
            print(f"{name}: {resolved_family(alias)}")
        return 0
    if family is None:
        print(f"theme: name a font family: theme font {kind} <family>", file=sys.stderr)
        return 1

    installed = next((f for f in installed_families() if f.casefold() == family.casefold()), None)
    if installed is None:
        print(f"theme: no installed font family '{family}' (see `fc-list : family`)", file=sys.stderr)
        return 1

    choices: dict[str, str] = {}
    if paths.font_choices.exists():
        choices = json.loads(paths.font_choices.read_text())
    choices[kind] = installed
    write_atomic(paths.font_choices, json.dumps(choices, indent=2) + "\n")
    write_atomic(paths.fonts_conf, fonts_conf(choices))
    return report_hooks(paths, current_name(paths) or "", f"set the {kind} font to {installed}")


def cmd_list(paths: Paths) -> int:
    current = current_name(paths)
    for name in theme_names(paths):
        print(f"{'*' if name == current else ' '} {name}")
    return 0


def cmd_current(paths: Paths) -> int:
    name = current_name(paths)
    if name is None:
        print("theme: no theme set yet; run `theme set <name>`", file=sys.stderr)
        return 1
    print(name)
    return 0


def cmd_check(paths: Paths, names: list[str]) -> int:
    failed = False
    for name in names or theme_names(paths):
        try:
            palette = load_palette(find_theme(paths, name))
            with tempfile.TemporaryDirectory() as scratch:
                render_theme(palette, paths.templates, Path(scratch))
        except (ThemeError, OSError) as error:
            print(f"theme: {error}", file=sys.stderr)
            failed = True
        else:
            print(f"ok {name}")
    return 1 if failed else 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="theme", description=__doc__.splitlines()[0])
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("list", help="list themes; the current one is marked")
    commands.add_parser("current", help="print the current theme's name")
    set_ = commands.add_parser("set", help="switch to a theme and reload what uses it")
    set_.add_argument("name")
    check = commands.add_parser("check", help="validate and render without switching")
    check.add_argument("names", nargs="*", metavar="name")
    font = commands.add_parser("font", help="show the fonts in use, or set the mono or sans family")
    font.add_argument("kind", nargs="?", choices=tuple(FONT_ALIASES))
    font.add_argument("family", nargs="?")
    args = parser.parse_args(argv)

    paths = Paths.from_env()
    match args.command:
        case "list":
            return cmd_list(paths)
        case "current":
            return cmd_current(paths)
        case "set":
            return cmd_set(paths, args.name)
        case "font":
            return cmd_font(paths, args.kind, args.family)
        case _:
            return cmd_check(paths, args.names)


if __name__ == "__main__":
    sys.exit(main())
